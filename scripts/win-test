#!/usr/bin/env bash
set -euo pipefail

host="${WIN_TEST_HOST:-win-1}"
windows_root='C:/dev/local-sandbox-agent'
windows_state_root='C:/dev/local-sandbox-agent-state'
snapshot_index=''
snapshot_objects=''
runtime_assets_temp=''
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

usage() {
    cat <<'EOF'
Usage:
  scripts/win-test list
  scripts/win-test doctor [profile]
  scripts/win-test reset [--full]
  scripts/win-test accept <runtime|diagnostics|service|release> [options]
  scripts/win-test setup
  scripts/win-test verify
  scripts/win-test provision-signing
  scripts/win-test provision-signing-windows
  scripts/win-test verify-signing
  scripts/win-test provision-runtime
  scripts/win-test verify-runtime
  scripts/win-test preflight
  scripts/win-test run -- <executable> [arguments...]
  scripts/win-test suite <suite-name> [--reuse-candidate <run-id>]
  scripts/win-test reboot <suite-name> [--reuse-candidate <run-id>]
  scripts/win-test resume <run-id>
  scripts/win-test finalize <runtime|diagnostics|service|release> <run-id>
  scripts/win-test fetch <run-id> <new-local-directory>
  scripts/win-test runs
  scripts/win-test show <run-id>
  scripts/win-test prune --dry-run
  scripts/win-test prune [--older-than 14d] [--keep 20]

WIN_TEST_HOST overrides the default SSH alias "win-1".
EOF
}

fail() {
    printf 'win-test: %s\n' "$*" >&2
    exit 2
}

cleanup() {
    if [[ -n "$snapshot_index" && -f "$snapshot_index" ]]; then
        rm -f "$snapshot_index"
    fi
    if [[ -n "$snapshot_objects" && -d "$snapshot_objects" ]]; then
        rm -rf -- "$snapshot_objects"
    fi
    if [[ -n "$runtime_assets_temp" && -d "$runtime_assets_temp" ]]; then
        rm -rf -- "$runtime_assets_temp"
    fi
}
trap cleanup EXIT

validate_host() {
    [[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || fail 'WIN_TEST_HOST must be an SSH host alias without shell metacharacters'
}

ssh_windows() {
    ssh \
        -n \
        -o BatchMode=yes \
        -o ConnectTimeout=8 \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=4 \
        "$host" "$@"
}

setup_host() {
    local staging="C:/Windows/Temp/local-sandbox-agent-setup-$$"
    local setup_status=0 cleanup_status=0
    if ssh_windows pwsh -NoProfile -NonInteractive -Command \
        "New-Item -ItemType Directory -Force -Path '$staging' | Out-Null" && \
        scp \
            -o BatchMode=yes \
            -o ConnectTimeout=8 \
            -r \
            "$script_dir/setup-windows-test-host.ps1" \
            "$script_dir/windows-test-bootstrap.ps1" \
            "$script_dir/windows-test-signing-assets.ps1" \
            "$script_dir/windows-test-runtime-assets.ps1" \
            "$script_dir/windows-test-artifacts.ps1" \
            "$script_dir/windows-test" \
            "${host}:${staging}/" && \
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${staging}/setup-windows-test-host.ps1" \
            -BootstrapSource "${staging}/windows-test-bootstrap.ps1" \
            -SigningAssetsSource "${staging}/windows-test-signing-assets.ps1" \
            -RuntimeAssetsSource "${staging}/windows-test-runtime-assets.ps1" \
            -ArtifactFetchSource "${staging}/windows-test-artifacts.ps1" \
            -WindowsTestSupportSource "${staging}/windows-test" && \
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/setup-windows-test-host.ps1" -VerifyOnly; then
        setup_status=0
    else
        setup_status=$?
    fi
    ssh_windows pwsh -NoProfile -NonInteractive -Command \
        "Remove-Item -LiteralPath '$staging' -Recurse -Force -ErrorAction SilentlyContinue" || \
        cleanup_status=$?
    if (( setup_status != 0 )); then
        return "$setup_status"
    fi
    return "$cleanup_status"
}

provision_signing() {
    local pfx_path="${SEAWORK_WINDOWS_PFX_PATH:-}"
    local password_path="${SEAWORK_WINDOWS_PFX_PASSWORD_FILE:-}"
    local stage_name="$(date -u '+%Y%m%dt%H%M%Sz')-$$"
    local remote_stage="${windows_state_root}/assets/.signing-stage-$stage_name"
    [[ -n "$pfx_path" && -f "$pfx_path" ]] || \
        fail 'SEAWORK_WINDOWS_PFX_PATH must name the local PFX file'
    [[ -n "$password_path" && -f "$password_path" ]] || \
        fail 'SEAWORK_WINDOWS_PFX_PASSWORD_FILE must name the local password file'
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-signing-assets.ps1" -Mode Prepare -StageName "$stage_name"
    local provision_status=0
    if scp -q -o BatchMode=yes -o ConnectTimeout=8 \
        "$pfx_path" "${host}:${remote_stage}/SeaWork-CodeSign.pfx" && \
        scp -q -o BatchMode=yes -o ConnectTimeout=8 \
        "$password_path" "${host}:${remote_stage}/win_csc_key_password.txt" && \
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test-signing-assets.ps1" -Mode Commit -StageName "$stage_name"; then
        provision_status=0
    else
        provision_status=$?
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test-signing-assets.ps1" -Mode Abort -StageName "$stage_name" || true
    fi
    return "$provision_status"
}

verify_signing() {
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-signing-assets.ps1" -Mode Verify
}

provision_signing_windows() {
    local source_root="${SEAWORK_WINDOWS_SIGNING_SOURCE_ROOT:-C:/Users/Public/code/private}"
    local stage_name="$(date -u '+%Y%m%dt%H%M%Sz')-$$"
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-signing-assets.ps1" \
        -Mode ImportLocal -StageName "$stage_name" -SourceRoot "$source_root"
}

provision_runtime() {
    local runtime_root="${LSB_WINDOWS_RUNTIME_ROOT:-}"
    local stage_name="$(date -u '+%Y%m%dt%H%M%Sz')-$$"
    local remote_stage="${windows_state_root}/assets/.runtime-stage-$stage_name"
    local archive_dir archive_path
    [[ -n "$runtime_root" && -d "$runtime_root" ]] || \
        fail 'LSB_WINDOWS_RUNTIME_ROOT must name the local runtime asset directory'
    for asset_name in Image initramfs.cpio.gz rootfs.ext4; do
        [[ -f "$runtime_root/$asset_name" ]] || fail "runtime asset is missing: $asset_name"
    done
    archive_dir="$(mktemp -d "${TMPDIR:-/tmp}/local-sandbox-runtime-assets.XXXXXX")"
    runtime_assets_temp="$archive_dir"
    archive_path="$archive_dir/runtime-assets.tar.gz"
    COPYFILE_DISABLE=1 tar -czf "$archive_path" -C "$runtime_root" \
        Image initramfs.cpio.gz rootfs.ext4
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-runtime-assets.ps1" -Mode Prepare -StageName "$stage_name"
    local provision_status=0
    if scp -q -o BatchMode=yes -o ConnectTimeout=8 \
        "$archive_path" "${host}:${remote_stage}/runtime-assets.tar.gz" && \
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test-runtime-assets.ps1" -Mode Commit -StageName "$stage_name"; then
        provision_status=0
    else
        provision_status=$?
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test-runtime-assets.ps1" -Mode Abort -StageName "$stage_name" || true
    fi
    rm -rf -- "$archive_dir"
    runtime_assets_temp=''
    return "$provision_status"
}

verify_runtime() {
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-runtime-assets.ps1" -Mode Verify
}

fetch_artifacts() {
    local fetch_run_id="$1" destination="$2" listing name expected_sha expected_size observed_sha
    [[ "$fetch_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail 'invalid run ID'
    [[ ! -e "$destination" ]] || fail "fetch destination already exists: $destination"
    mkdir -p -- "$destination"
    listing="$(ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test-artifacts.ps1" -RunId "$fetch_run_id")"
    while IFS=$'\t' read -r name expected_sha expected_size; do
        name="${name//$'\r'/}"
        expected_sha="${expected_sha//$'\r'/}"
        expected_size="${expected_size//$'\r'/}"
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}$ ]] || fail 'remote artifact name is unsafe'
        [[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || fail "remote artifact hash is invalid: $name"
        [[ "$expected_size" =~ ^[0-9]+$ ]] || fail "remote artifact size is invalid: $name"
        scp -q -o BatchMode=yes -o ConnectTimeout=8 \
            "${host}:${windows_state_root}/runs/${fetch_run_id}/${name}" \
            "$destination/$name"
        [[ "$(wc -c < "$destination/$name" | tr -d ' ')" == "$expected_size" ]] || \
            fail "downloaded artifact size mismatch: $name"
        observed_sha="$(shasum -a 256 "$destination/$name" | awk '{print $1}')"
        [[ "$observed_sha" == "$expected_sha" ]] || fail "downloaded artifact hash mismatch: $name"
    done <<< "$listing"
}

verify_host() {
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/setup-windows-test-host.ps1" -VerifyOnly
}

create_snapshot() {
    local base_sha tree_sha message discovered_root git_dir base_objects
    discovered_root="$(git -C "$repo_root" rev-parse --show-toplevel)"
    [[ "$discovered_root" == "$repo_root" ]] || fail "script directory is not inside the expected Git root: $repo_root"
    cd "$repo_root"
    base_sha="$(git rev-parse HEAD)"
    git_dir="$(git rev-parse --absolute-git-dir)"
    base_objects="$git_dir/objects"
    snapshot_index="$(mktemp "${TMPDIR:-/tmp}/local-sandbox-win-test-index.XXXXXX")"
    snapshot_objects="$(mktemp -d "${TMPDIR:-/tmp}/local-sandbox-win-test-objects.XXXXXX")"
    rm -f "$snapshot_index"
    GIT_INDEX_FILE="$snapshot_index" \
        GIT_OBJECT_DIRECTORY="$snapshot_objects" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_objects" \
        git read-tree HEAD
    GIT_INDEX_FILE="$snapshot_index" \
        GIT_OBJECT_DIRECTORY="$snapshot_objects" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_objects" \
        git add -A -- .
    tree_sha="$(GIT_INDEX_FILE="$snapshot_index" \
        GIT_OBJECT_DIRECTORY="$snapshot_objects" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_objects" \
        git write-tree)"
    message="Local Windows test snapshot based on $base_sha"
    snapshot_sha="$(printf '%s\n' "$message" | \
        GIT_OBJECT_DIRECTORY="$snapshot_objects" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_objects" \
        git commit-tree "$tree_sha" -p "$base_sha")"
    run_id="$(date -u '+%Y%m%dt%H%M%Sz')-$$-${snapshot_sha:0:12}"
    snapshot_ref="refs/heads/snapshots/$run_id"
    GIT_OBJECT_DIRECTORY="$snapshot_objects" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_objects" \
        git push --quiet --force "${host}:${windows_root}/mirror.git" \
            "$base_sha:refs/heads/snapshot-bases/current" \
            "$snapshot_sha:$snapshot_ref"
    printf 'Windows test run: %s\nSnapshot: %s (base %s)\n' \
        "$run_id" "$snapshot_sha" "$base_sha"
}

encode_command() {
    [[ "$#" -gt 0 ]] || fail 'run requires an executable after --'
    command_spec_base64="$(printf '%s\0' "$@" | base64 | tr -d '\n')"
}

invoke_bootstrap() {
    local mode="$1" suite="$2" command_spec="${3:-}" reuse_run_id="${4:-}"
    local bootstrap_arguments=(
        pwsh -NoProfile -NonInteractive -File
        "${windows_root}/bootstrap.ps1"
        -Mode "$mode"
        -RunId "$run_id"
        -SnapshotSha "$snapshot_sha"
        -SnapshotRef "$snapshot_ref"
        -Suite "$suite"
    )
    if [[ -n "$command_spec" ]]; then
        bootstrap_arguments+=( -CommandSpecBase64 "$command_spec" )
    fi
    if [[ -n "$reuse_run_id" ]]; then
        bootstrap_arguments+=( -ReuseRunId "$reuse_run_id" )
    fi
    ssh_windows "${bootstrap_arguments[@]}"
}

get_boot_id() {
    ssh_windows pwsh -NoProfile -NonInteractive -Command \
        '(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().Ticks.ToString()'
}

wait_for_reboot() {
    local old_boot_id="$1" deadline now observed
    deadline=$(( $(date +%s) + 900 ))
    printf 'Waiting for Windows to reboot and sshd to return...\n'
    while (( $(date +%s) < deadline )); do
        observed="$(get_boot_id 2>/dev/null || true)"
        observed="${observed//$'\r'/}"
        observed="${observed//$'\n'/}"
        if [[ -n "$observed" && "$observed" != "$old_boot_id" ]]; then
            printf 'Windows returned with a new boot identity.\n'
            return 0
        fi
        sleep 5
    done
    fail "Windows did not complete reboot within 15 minutes; resume later with: scripts/win-test resume $run_id"
}

wait_for_interactive_user() {
    local deadline observed
    deadline=$(( $(date +%s) + 900 ))
    printf 'Waiting for the standard-user console session required by the filtered-token proof...\n'
    while (( $(date +%s) < deadline )); do
        observed="$(ssh_windows pwsh -NoProfile -NonInteractive -Command \
            '"(Get-CimInstance Win32_ComputerSystem).UserName"' 2>/dev/null || true)"
        observed="${observed//$'\r'/}"
        observed="${observed//$'\n'/}"
        if [[ -n "$observed" ]]; then
            printf 'Interactive Windows session detected; resuming the exact run.\n'
            return 0
        fi
        sleep 5
    done
    fail "No interactive Windows user signed in within 15 minutes; sign in, then resume with: scripts/win-test resume $run_id"
}

resume_run() {
    local resume_id="$1"
    [[ "$resume_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail 'invalid run ID'
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/bootstrap.ps1" -Mode Resume -RunId "$resume_id"
}

finalize_profile() {
    local profile="$1" finalize_run_id="$2"
    [[ "$profile" =~ ^(runtime|diagnostics|service|release)$ ]] || fail 'invalid profile'
    [[ "$finalize_run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || fail 'invalid run ID'
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test/host/windows-test-profile.ps1" \
        -Profile "$profile" -RunId "$finalize_run_id"
}

invoke_current_reboot_suite() {
    local suite_name="$1" reuse_run_id="${2:-}" old_boot_id reboot_status
    old_boot_id="$(get_boot_id)"
    old_boot_id="${old_boot_id//$'\r'/}"
    old_boot_id="${old_boot_id//$'\n'/}"
    if ! invoke_bootstrap Reboot "$suite_name" '' "$reuse_run_id"; then
        reboot_status=$?
        (( reboot_status != 0 )) || reboot_status=1
        return "$reboot_status"
    fi
    wait_for_reboot "$old_boot_id"
    wait_for_interactive_user
    resume_run "$run_id"
}

import_release_file() {
    local artifact_path="$1" artifact_name expected_sha expected_size remote_stage import_status=0
    [[ -f "$artifact_path" ]] || fail "release artifact is not a file: $artifact_path"
    artifact_name="$(basename "$artifact_path")"
    [[ "$artifact_name" =~ ^lsb-seawork-(service-v[0-9A-Za-z.+-]+-windows-x86_64\.zip|updater-v[0-9A-Za-z.+-]+-windows-x86_64(\.zip|-manifest\.json))$ ]] || \
        fail 'release artifact filename is not canonical'
    expected_sha="$(shasum -a 256 "$artifact_path" | awk '{print $1}')"
    expected_size="$(wc -c < "$artifact_path" | tr -d ' ')"
    remote_stage="$(ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test/host/windows-test-release-artifact.ps1" \
        -Mode Prepare -RunId "$run_id" -FileName "$artifact_name" \
        -SnapshotSha "$snapshot_sha")"
    remote_stage="${remote_stage//$'\r'/}"
    remote_stage="${remote_stage//$'\n'/}"
    if scp -q -o BatchMode=yes -o ConnectTimeout=8 \
        "$artifact_path" "${host}:${remote_stage}/${artifact_name}" && \
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test/host/windows-test-release-artifact.ps1" \
            -Mode Commit -RunId "$run_id" -FileName "$artifact_name" \
            -ExpectedSha256 "$expected_sha" -ExpectedSize "$expected_size"; then
        import_status=0
    else
        import_status=$?
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test/host/windows-test-release-artifact.ps1" \
            -Mode Abort -RunId "$run_id" -FileName "$artifact_name" || true
    fi
    return "$import_status"
}

import_baseline_tuple() {
    local directory="$1" path version='' observed_version count=0
    [[ -d "$directory" ]] || fail "baseline tuple directory does not exist: $directory"
    local -a files=(
        "$directory"/lsb-seawork-service-v*-windows-x86_64.zip
        "$directory"/lsb-seawork-updater-v*-windows-x86_64.zip
        "$directory"/lsb-seawork-updater-v*-windows-x86_64-manifest.json
    )
    for path in "${files[@]}"; do
        [[ -f "$path" ]] || fail 'baseline directory must contain one service/updater/manifest tuple'
        observed_version="$(basename "$path" | sed -E 's/^lsb-seawork-(service|updater)-v([^/]+)-windows-x86_64(-manifest)?\.(zip|json)$/\2/')"
        [[ "$observed_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || \
            fail 'baseline tuple contains a noncanonical version'
        if [[ -z "$version" ]]; then version="$observed_version"; fi
        [[ "$version" == "$observed_version" ]] || fail 'baseline tuple versions disagree'
        import_release_file "$path"
        count=$((count + 1))
    done
    [[ "$count" -eq 3 ]] || fail 'baseline tuple must contain exactly three required files'
}

import_candidate_tuple() {
    local service_archive="$1" directory version updater_archive updater_manifest
    directory="$(cd "$(dirname "$service_archive")" && pwd)"
    service_archive="$directory/$(basename "$service_archive")"
    [[ "$(basename "$service_archive")" =~ ^lsb-seawork-service-v([0-9A-Za-z.+-]+)-windows-x86_64\.zip$ ]] || \
        fail 'candidate service archive filename is not canonical'
    version="${BASH_REMATCH[1]}"
    updater_archive="$directory/lsb-seawork-updater-v${version}-windows-x86_64.zip"
    updater_manifest="$directory/lsb-seawork-updater-v${version}-windows-x86_64-manifest.json"
    [[ -f "$updater_archive" && -f "$updater_manifest" ]] || \
        fail 'candidate directory must contain the matching updater archive and manifest'
    # Import the service last so imported-release-artifact.json remains the service record.
    import_release_file "$updater_archive"
    import_release_file "$updater_manifest"
    import_release_file "$service_archive"
}

accept_profile() {
    local profile="$1"
    shift
    local include_optional=0 reuse_run_id='' artifact_path='' artifact_basename='' baseline_dir='' profile_status=0
    local suite_name reboot_mode profile_plan
    local -a profile_plan_arguments finalize_arguments
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --include-optional)
                (( include_optional == 0 )) || fail '--include-optional was specified more than once'
                include_optional=1
                shift
                ;;
            --reuse-candidate)
                [[ "$#" -ge 2 && "$2" =~ ^[a-z0-9][a-z0-9._-]{0,95}$ ]] || \
                    fail '--reuse-candidate requires a valid run ID'
                [[ -z "$reuse_run_id" ]] || fail '--reuse-candidate was specified more than once'
                reuse_run_id="$2"
                shift 2
                ;;
            --artifact)
                [[ "$#" -ge 2 && -n "$2" ]] || fail '--artifact requires a local ZIP path'
                [[ -z "$artifact_path" ]] || fail '--artifact was specified more than once'
                artifact_path="$2"
                shift 2
                ;;
            --baseline-dir)
                [[ "$#" -ge 2 && -n "$2" ]] || fail '--baseline-dir requires a local directory'
                [[ -z "$baseline_dir" ]] || fail '--baseline-dir was specified more than once'
                baseline_dir="$2"
                shift 2
                ;;
            *) fail "unknown accept option: $1" ;;
        esac
    done
    if [[ "$profile" != diagnostics && "$include_optional" -eq 1 ]]; then
        fail '--include-optional is supported only by the diagnostics profile'
    fi
    if [[ "$profile" != service && "$profile" != release && -n "$reuse_run_id" ]]; then
        fail '--reuse-candidate is supported only by service and release profiles'
    fi
    if [[ "$profile" != release && -n "$artifact_path" ]]; then
        fail '--artifact is supported only by the release profile'
    fi
    if [[ "$profile" != release && -n "$baseline_dir" ]]; then
        fail '--baseline-dir is supported only by the release profile'
    fi
    if [[ "$profile" == release && -z "$baseline_dir" ]]; then
        fail 'release acceptance requires --baseline-dir <directory>'
    fi
    if [[ -n "$reuse_run_id" && -n "$artifact_path" ]]; then
        fail '--artifact and --reuse-candidate are mutually exclusive'
    fi
    if [[ "$profile" == release && -z "$reuse_run_id" && -z "$artifact_path" ]]; then
        fail 'release acceptance requires --artifact <zip> or --reuse-candidate <run-id>'
    fi
    if [[ -n "$artifact_path" ]]; then
        [[ -f "$artifact_path" ]] || fail "release artifact is not a file: $artifact_path"
        artifact_basename="$(basename "$artifact_path")"
        [[ "$artifact_basename" =~ ^lsb-seawork-service-v[0-9A-Za-z.+-]+-windows-x86_64\.zip$ ]] || \
            fail 'release artifact filename is not canonical'
    fi

    if [[ "$profile" == service || "$profile" == release ]]; then
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test/host/windows-test-reset.ps1" '-Confirm:$false'
    fi
    ssh_windows pwsh -NoProfile -NonInteractive -File \
        "${windows_root}/windows-test/host/windows-test-doctor.ps1" -Profile "$profile"

    create_snapshot
    import_baseline_tuple "$baseline_dir"
    if [[ -n "$artifact_path" ]]; then
        import_candidate_tuple "$artifact_path"
    fi
    profile_plan_arguments=(
        pwsh -NoProfile -NonInteractive -File
        "$script_dir/windows-test/profile-plan.ps1" -Profile "$profile"
    )
    if (( include_optional == 1 )); then
        profile_plan_arguments+=( -IncludeOptional )
    fi
    profile_plan="$("${profile_plan_arguments[@]}")"
    while IFS=$'\t' read -r suite_name reboot_mode; do
        suite_name="${suite_name//$'\r'/}"
        reboot_mode="${reboot_mode//$'\r'/}"
        [[ "$suite_name" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || fail 'catalog emitted an invalid suite name'
        [[ "$reboot_mode" =~ ^(none|required)$ ]] || fail 'catalog emitted an invalid reboot mode'
        if (( profile_status != 0 )); then
            break
        fi
        if [[ "$reboot_mode" == required ]]; then
            if ! invoke_current_reboot_suite "$suite_name" "$reuse_run_id"; then
                profile_status=$?
                (( profile_status != 0 )) || profile_status=1
            fi
        elif ! invoke_bootstrap Run "$suite_name" '' "$reuse_run_id"; then
            profile_status=$?
            (( profile_status != 0 )) || profile_status=1
        fi
    done <<< "$profile_plan"

    finalize_arguments=(
        pwsh -NoProfile -NonInteractive -File
        "${windows_root}/windows-test/host/windows-test-profile.ps1"
        -Profile "$profile" -RunId "$run_id"
    )
    if (( include_optional == 1 )); then
        finalize_arguments+=( -IncludeOptional )
    fi
    if ! ssh_windows "${finalize_arguments[@]}"; then
        profile_status=$?
        (( profile_status != 0 )) || profile_status=1
    fi
    return "$profile_status"
}

validate_host
[[ "$#" -gt 0 ]] || { usage; exit 2; }
action="$1"
shift

case "$action" in
    list)
        [[ "$#" -eq 0 ]] || fail 'list takes no arguments'
        pwsh -NoProfile -NonInteractive -File "$script_dir/windows-test/list.ps1"
        ;;
    doctor)
        [[ "$#" -le 1 ]] || fail 'doctor takes at most one profile'
        doctor_arguments=(
            pwsh -NoProfile -NonInteractive -File
            "${windows_root}/windows-test/host/windows-test-doctor.ps1"
        )
        if [[ "$#" -eq 1 ]]; then
            [[ "$1" =~ ^(runtime|diagnostics|service|release)$ ]] || fail 'invalid doctor profile'
            doctor_arguments+=( -Profile "$1" )
        fi
        ssh_windows "${doctor_arguments[@]}"
        ;;
    reset)
        [[ "$#" -le 1 ]] || fail 'reset accepts only --full'
        reset_arguments=(
            pwsh -NoProfile -NonInteractive -File
            "${windows_root}/windows-test/host/windows-test-reset.ps1"
            '-Confirm:$false'
        )
        if [[ "$#" -eq 1 ]]; then
            [[ "$1" == '--full' ]] || fail 'reset accepts only --full'
            reset_arguments+=( -Full )
        fi
        ssh_windows "${reset_arguments[@]}"
        ;;
    accept)
        [[ "$#" -ge 1 ]] || fail 'accept requires a profile'
        [[ "$1" =~ ^(runtime|diagnostics|service|release)$ ]] || fail 'invalid acceptance profile'
        profile_name="$1"
        shift
        accept_profile "$profile_name" "$@"
        ;;
    setup)
        [[ "$#" -eq 0 ]] || fail 'setup takes no arguments'
        setup_host
        ;;
    verify)
        [[ "$#" -eq 0 ]] || fail 'verify takes no arguments'
        verify_host
        ;;
    provision-signing)
        [[ "$#" -eq 0 ]] || fail 'provision-signing takes no arguments'
        provision_signing
        ;;
    provision-signing-windows)
        [[ "$#" -eq 0 ]] || fail 'provision-signing-windows takes no arguments'
        provision_signing_windows
        ;;
    verify-signing)
        [[ "$#" -eq 0 ]] || fail 'verify-signing takes no arguments'
        verify_signing
        ;;
    provision-runtime)
        [[ "$#" -eq 0 ]] || fail 'provision-runtime takes no arguments'
        provision_runtime
        ;;
    verify-runtime)
        [[ "$#" -eq 0 ]] || fail 'verify-runtime takes no arguments'
        verify_runtime
        ;;
    preflight)
        [[ "$#" -eq 0 ]] || fail 'preflight takes no arguments'
        create_snapshot
        invoke_bootstrap Run preflight
        ;;
    run)
        [[ "${1:-}" == '--' ]] || fail 'run syntax is: scripts/win-test run -- <executable> [arguments...]'
        shift
        encode_command "$@"
        create_snapshot
        invoke_bootstrap Run command "$command_spec_base64"
        ;;
    suite)
        [[ "$#" -eq 1 || "$#" -eq 3 ]] || \
            fail 'suite syntax is: scripts/win-test suite <suite-name> [--reuse-candidate <run-id>]'
        [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || fail 'invalid suite name'
        suite_name="$1"
        reuse_run_id=''
        if [[ "$#" -eq 3 ]]; then
            [[ "$2" == '--reuse-candidate' ]] || fail 'unknown suite option'
            [[ "$3" =~ ^[a-z0-9][a-z0-9._-]{0,95}$ ]] || fail 'invalid reuse candidate run ID'
            reuse_run_id="$3"
        fi
        create_snapshot
        invoke_bootstrap Run "$suite_name" '' "$reuse_run_id"
        ;;
    reboot)
        [[ "$#" -eq 1 || "$#" -eq 3 ]] || \
            fail 'reboot syntax is: scripts/win-test reboot <suite-name> [--reuse-candidate <run-id>]'
        [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || fail 'invalid suite name'
        suite_name="$1"
        reuse_run_id=''
        if [[ "$#" -eq 3 ]]; then
            [[ "$2" == '--reuse-candidate' ]] || fail 'unknown reboot option'
            [[ "$3" =~ ^[a-z0-9][a-z0-9._-]{0,95}$ ]] || fail 'invalid reuse candidate run ID'
            reuse_run_id="$3"
        fi
        old_boot_id="$(get_boot_id)"
        old_boot_id="${old_boot_id//$'\r'/}"
        old_boot_id="${old_boot_id//$'\n'/}"
        create_snapshot
        invoke_bootstrap Reboot "$suite_name" '' "$reuse_run_id"
        wait_for_reboot "$old_boot_id"
        wait_for_interactive_user
        resume_run "$run_id"
        ;;
    resume)
        [[ "$#" -eq 1 ]] || fail 'resume requires exactly one run ID'
        wait_for_interactive_user
        resume_run "$1"
        ;;
    finalize)
        [[ "$#" -eq 2 ]] || fail 'finalize requires a profile and run ID'
        finalize_profile "$1" "$2"
        ;;
    fetch)
        [[ "$#" -eq 2 ]] || fail 'fetch requires a run ID and a new local destination directory'
        fetch_artifacts "$1" "$2"
        ;;
    runs)
        [[ "$#" -eq 0 ]] || fail 'runs takes no arguments'
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test/host/windows-test-runs.ps1" -Mode List
        ;;
    show)
        [[ "$#" -eq 1 ]] || fail 'show requires exactly one run ID'
        [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,95}$ ]] || fail 'invalid run ID'
        ssh_windows pwsh -NoProfile -NonInteractive -File \
            "${windows_root}/windows-test/host/windows-test-runs.ps1" -Mode Show -RunId "$1"
        ;;
    prune)
        prune_arguments=(
            pwsh -NoProfile -NonInteractive -File
            "${windows_root}/windows-test/host/windows-test-prune.ps1"
        )
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --dry-run)
                    prune_arguments+=( -DryRun )
                    shift
                    ;;
                --older-than)
                    [[ "$#" -ge 2 && "$2" =~ ^[1-9][0-9]*d$ ]] || fail '--older-than requires a value such as 14d'
                    prune_arguments+=( -OlderThan "$2" )
                    shift 2
                    ;;
                --keep)
                    [[ "$#" -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || fail '--keep requires a positive integer'
                    prune_arguments+=( -Keep "$2" )
                    shift 2
                    ;;
                *) fail "unknown prune option: $1" ;;
            esac
        done
        ssh_windows "${prune_arguments[@]}"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        fail "unknown action: $action"
        ;;
esac
