{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-sandbox.dev/schemas/windows-test-fetch-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_utc", "artifacts"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "sha256", "size", "kind", "redacted"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 8589934592 },
          "kind": { "enum": ["result", "evidence", "manifest", "release-artifact"] },
          "redacted": { "type": "boolean" }
        }
      }
    }
  }
}
