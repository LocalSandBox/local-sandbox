{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-sandbox.dev/schemas/windows-test-result-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "snapshot_sha", "suite", "category", "phase", "status", "exit_code", "failure_code", "started_utc", "finished_utc", "duration_ms", "boot_id", "output_file", "required_capabilities", "mutations", "expected_artifacts", "acceptance_checks", "bindings"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "snapshot_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "suite": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "category": { "enum": ["native", "runtime", "diagnostics", "service", "release"] },
    "phase": { "enum": ["Normal", "BeforeReboot", "AfterReboot"] },
    "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "failure_code": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "boot_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
    "output_file": { "type": "string", "pattern": "^output-[a-z0-9-]+-(normal|beforereboot|afterreboot)\\.log$" },
    "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
    "mutations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "expected_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}$" } },
    "acceptance_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9_]+$" } },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_assets_sha256", "release_artifact_sha256"],
      "properties": {
        "runtime_assets_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "release_artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
